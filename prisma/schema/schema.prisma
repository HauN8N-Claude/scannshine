// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  output   = "../../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
}

model Feedback {
  id      String  @id @default(nanoid(11))
  review  Int
  message String
  email   String?
  userId  String?
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- ScanNShine ---

enum SubStatus {
  ONBOARDING
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELLED
}

enum ScanType {
  SCAN
  CLICK_GOOGLE
  FEEDBACK_PRIVATE
}

model Business {
  id     String @id @default(nanoid(11))
  userId String @unique
  user   User   @relation("UserBusiness", fields: [userId], references: [id], onDelete: Cascade)

  name       String
  slug       String  @unique
  logoUrl    String?
  brandColor String  @default("#0ea5e9")

  googlePlaceId String?
  googleMapsUrl String?

  dodoCustomerId     String?
  dodoSubscriptionId String?
  subscriptionStatus SubStatus @default(ONBOARDING)
  trialEndsAt        DateTime?
  cancelledAt        DateTime?

  onboardingStep Int @default(1)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scanEvents ScanEvent[]
  feedbacks  FeedbackPrivate[]
  contacts   Contact[]

  @@map("business")
}

model ScanEvent {
  id         String   @id @default(nanoid(11))
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  type        ScanType
  visitorHash String?

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@index([businessId, type, visitorHash, createdAt])
  @@map("scan_event")
}

model FeedbackPrivate {
  id         String   @id @default(nanoid(11))
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  message String
  rating  Int?

  contactName  String?
  contactPhone String?
  contactEmail String?

  isRead Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([businessId, createdAt])
  @@map("feedback_private")
}

model Contact {
  id         String   @id @default(nanoid(11))
  businessId String
  business   Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  name  String?
  phone String?
  email String?

  consentAt DateTime
  source    String   @default("collect_page")

  createdAt DateTime @default(now())

  @@unique([businessId, phone])
  @@index([businessId, createdAt])
  @@map("contact")
}
