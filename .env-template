# Database URL (use the same address in development, only use pooled in production if you use neon.tech)
# https://neon.tech/docs/guides/prisma
DATABASE_URL=""
DATABASE_URL_UNPOOLED=""

## * Redis (required in production for caching — optional in dev, falls back to in-memory)
# Get from: Railway ($5/mo), Redis Cloud (free tier), Upstash, or local Docker
REDIS_URL=""

## * BetterAuth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=

## * Resend (transactional emails — optional in dev, emails are logged instead)
RESEND_API_KEY=""
RESEND_AUDIENCE_ID=""
EMAIL_FROM="ScanNShine <contact@scannshine.com>"
NEXT_PUBLIC_EMAIL_CONTACT="contact@scannshine.com"

## * Dodo Payments (subscriptions — Merchant of Record)
# https://docs.dodopayments.com — test_mode keys first, live_mode after KYC
DODO_PAYMENTS_API_KEY=""
DODO_PAYMENTS_WEBHOOK_KEY=""
DODO_PAYMENTS_ENVIRONMENT="test_mode"
DODO_PRODUCT_ID=""

## * PostHog (optional - analytics)
NEXT_PUBLIC_POSTHOG_KEY=""
NEXT_PUBLIC_POSTHOG_HOST=""

## * File Upload (logo du commerce)
# Vercel Blob (default): BLOB_READ_WRITE_TOKEN is auto-configured on Vercel
# For local dev with Vercel Blob, get token from: Vercel Dashboard > Storage > Blob > Tokens
BLOB_READ_WRITE_TOKEN=""
